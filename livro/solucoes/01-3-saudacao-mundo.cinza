// Capítulo 1, exercício 3: sem argumentos, cumprimenta "mundo" em vez de sair com erro.
fn saudacao(string nome) -> string {
  return "Olá, " + nome + "!";
}

fn main(list<string> args) {
  if (args.size() == 0) {
    print(saudacao("mundo"));
    return;
  }
  for (string nome in args) {
    print(saudacao(nome));
  }
  print("Saudei", args.size(), "pessoas.");
}
// expect: Olá, mundo!
