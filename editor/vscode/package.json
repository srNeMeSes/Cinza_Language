{
  "name": "cinza-language",
  "displayName": "Cinza Language",
  "description": "A linguagem Cinza: destaque de sintaxe, os erros do compilador enquanto se digita e a formatação (o servidor de linguagem do cinza)",
  "version": "0.9.0",
  "publisher": "cinza",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/srNeMeSes/Cinza_Language"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:cinza"
  ],
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "cinza",
        "aliases": [
          "Cinza",
          "cinza"
        ],
        "extensions": [
          ".cinza"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cinza",
        "scopeName": "source.cinza",
        "path": "./syntaxes/cinza.tmLanguage.json"
      }
    ],
    "problemMatchers": [
      {
        "name": "cinza",
        "label": "Erros da Cinza (cinza e cinzac)",
        "owner": "cinza",
        "source": "cinza",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "severity": "error",
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): ([A-Za-z_][A-Za-z0-9_]*): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      }
    ],
    "configuration": {
      "title": "Cinza",
      "properties": {
        "cinza.caminho": {
          "type": "string",
          "default": "cinza",
          "description": "O executável do cinza, para o servidor de linguagem (cinza --lsp). Padrão: cinza, procurado no PATH."
        }
      }
    }
  }
}
