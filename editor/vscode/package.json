{
  "name": "cinza-language",
  "displayName": "Cinza Language",
  "description": "Destaque de sintaxe da linguagem Cinza e os erros do cinza (CVM) e do cinzac (LLVM) no painel Problemas",
  "version": "0.7.0",
  "publisher": "cinza",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/srNeMeSes/Cinza_Language"
  },
  "engines": {
    "vscode": "^1.50.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cinza",
        "aliases": [
          "Cinza",
          "cinza"
        ],
        "extensions": [
          ".cinza"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cinza",
        "scopeName": "source.cinza",
        "path": "./syntaxes/cinza.tmLanguage.json"
      }
    ],
    "problemMatchers": [
      {
        "name": "cinza",
        "label": "Erros da Cinza (cinza e cinzac)",
        "owner": "cinza",
        "source": "cinza",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "severity": "error",
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): ([A-Za-z_][A-Za-z0-9_]*): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      }
    ]
  }
}
