// Benchmark B2: métodos lendo e escrevendo campos da própria instância.
class Contador {
  i32 total = 0;
  i32 passos = 0;
  pub {
    fn soma(i32 v) {
      total += v;
      passos += 1;
    }
    fn valor() -> i32 { return total + passos; }
  }
}
fn main() {
  Contador c = new Contador();
  for (i32 i in range(0, 500000)) {
    c.soma(i % 10);
  }
  print(c.valor());
}
