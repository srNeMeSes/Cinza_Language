// Fase 7: namespace Lists.
import Lists as L;
fn main() {
  list<int> n = [5, 3, 9, 1];
  L.sort(n);
  print(n);
  list<string> s = ["pera", "abacate", "uva"];
  L.sort(s);
  L.reverse(s);
  print(s);
  print(L.contains(n, 9), L.contains(n, 4), L.index_of(n, 5), L.index_of(n, 7));
  print(L.slice(n, 1, 3), L.slice(n, 2, 2), L.sum(n));
  list<decimal> d = [1.5, 2];
  list<decimal> vazia;
  print(L.sum(d), L.sum(vazia), L.contains(d, 2));
}
// expect: [1, 3, 5, 9]
// expect: ["uva", "pera", "abacate"]
// expect: true false 2 -1
// expect: [3, 5] [] 18
// expect: 3.5 0 true
