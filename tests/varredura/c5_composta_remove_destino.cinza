// Q1e (varredura da spec, capítulo 5): se o valor remover o lugar de destino, a gravação lança o erro correspondente
fn tira(list<i32> l) -> i32 { l.remove(1); return 1; }
fn tira_chave(dict<string, i32> d) -> i32 { d.remove("a"); return 1; }
fn main() {
  list<i32> l = [1, 2];
  try { l[1] += tira(l); } except (IndexError e) { print("IndexError", l); }
  dict<string, i32> d = {{"a", 1}};
  try { d["a"] += tira_chave(d); } except (KeyError e) { print("KeyError", d); }
}
// expect: IndexError [1]
// expect: KeyError {}
