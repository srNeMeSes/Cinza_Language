// Q1e (varredura da spec, capítulo 5): os elementos são copiados no início do laço (também no dict)
fn main() {
  dict<string, i32> d = {{"a", 1}};
  for (pair<string, i32> p in d) { d.add({p.first + "x", 0}); }
  print(d);
  list<i32> l = [1, 2, 3];
  for (i32 x in l) { if (l.size() > 1) { l.remove(0); } print(x); }
}
// expect: {"a": 1, "ax": 0}
// expect: 1
// expect: 2
// expect: 3
