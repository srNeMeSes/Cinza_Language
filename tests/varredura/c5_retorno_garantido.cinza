// Q1e (varredura da spec, capítulo 5): garantem o retorno: if/else com os dois ramos, try com bloco e excepts, while (true) sem break, throw
fn a(bool b) -> i32 { if (b) { return 1; } else { return 2; } }
fn b() -> i32 { try { return 1; } except (Error e) { return 2; } }
fn c() -> i32 { while (true) { return 3; } }
fn d() -> i32 { throw ValueError("x"); }
fn e(bool x) -> i32 { if (x) { return 1; } else if (!x) { return 2; } else { throw ValueError("y"); } }
fn main() { print(a(true), a(false), b(), c(), e(false)); }
// expect: 1 2 1 3 2
