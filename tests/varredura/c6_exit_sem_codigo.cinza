// Q1e (varredura da spec, capítulo 6): exit() sai com 0, de dentro de uma função, e nenhum except o captura (nem Error); os finally rodam
fn sai() { exit(); }
fn main() {
  try {
    try { sai(); } except (Error e) { print("capturou"); } finally { print("finally 1"); }
  } finally { print("finally 2"); }
  print("nunca");
}
// expect: finally 1
// expect: finally 2
// expect-exit: 0
