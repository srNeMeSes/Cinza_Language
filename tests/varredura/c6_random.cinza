// Q1e (varredura da spec, capítulo 6): Random: os limites (os valores sorteados não fazem parte da spec)
import Random;
import Lists;
fn main() {
  try { print(Random.i32(3, 3)); } except (Error e) { print(e.kind); }
  try { print(Random.i32(4, 3)); } except (Error e) { print(e.kind); }
  try { print(Random.i64(9223372036854775807, 9223372036854775807)); } except (Error e) { print(e.kind); }
  try { print(Random.f64() < 1.ff); } except (Error e) { print(e.kind); }
  try { print(Random.f64_range(1.ff, 1.ff)); } except (Error e) { print(e.kind); }
  try { print(Random.f64_range(2.ff, 3.ff) >= 2.ff); } except (Error e) { print(e.kind); }
  try { print(Random.chance(0.ff)); } except (Error e) { print(e.kind); }
  try { print(Random.chance(1.ff)); } except (Error e) { print(e.kind); }
  try { print(Random.chance(1.5ff)); } except (Error e) { print(e.kind); }
  try { print(Random.chance(-0.1ff)); } except (Error e) { print(e.kind); }
  try { print(Random.gauss(5.ff, 0.ff)); } except (Error e) { print(e.kind); }
  try { print(Random.gauss(5.ff, -1.ff)); } except (Error e) { print(e.kind); }
  list<i32> vazia;
  try { print(Random.choice(vazia)); } except (Error e) { print(e.kind); }
  try { print(Random.choice([7])); } except (Error e) { print(e.kind); }
  try { print(Random.choices([1, 1], 5)); } except (Error e) { print(e.kind); }
  try { print(Random.choices(vazia, 1)); } except (Error e) { print(e.kind); }
  try { print(Random.choices(vazia, 0)); } except (Error e) { print(e.kind); }
  try { print(Random.choices([1], -1)); } except (Error e) { print(e.kind); }
  try { print(Random.sample([5], 1)); } except (Error e) { print(e.kind); }
  try { print(Random.sample([5], 2)); } except (Error e) { print(e.kind); }
  try { print(Random.sample(vazia, 0)); } except (Error e) { print(e.kind); }
  try { print(Random.sample([1, 2], -1)); } except (Error e) { print(e.kind); }
  try { print(Lists.sorted(Random.sample([3, 1, 2], 3))); } except (Error e) { print(e.kind); }
  list<i32> l = [1, 2, 3, 4];
  Random.shuffle(l);
  try { print(Lists.sorted(l)); } except (Error e) { print(e.kind); }
  try { print(type(Random.bool())); } except (Error e) { print(e.kind); }
}
// expect: 3
// expect: ValueError
// expect: 9223372036854775807
// expect: true
// expect: ValueError
// expect: true
// expect: false
// expect: true
// expect: ValueError
// expect: ValueError
// expect: 5
// expect: ValueError
// expect: IndexError
// expect: 7
// expect: [1, 1, 1, 1, 1]
// expect: IndexError
// expect: []
// expect: ValueError
// expect: [5]
// expect: ValueError
// expect: []
// expect: ValueError
// expect: [1, 2, 3]
// expect: [1, 2, 3, 4]
// expect: bool
