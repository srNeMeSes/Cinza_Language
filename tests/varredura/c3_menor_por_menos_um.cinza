// Q1e (varredura da spec, capítulo 3): menor / -1 é erro de runtime em 32 e em 64 bits; x % -1 é sempre 0
fn main() {
  i32 a = -2147483648;
  i64 b = -9223372036854775808;
  try { print(a / -1); } except (OverflowError e) { print("i32"); }
  try { print(b / -1); } except (OverflowError e) { print("i64"); }
  try { print(a % -1); } except (OverflowError e) { print("resto i32"); } except (Error e) { print("outro"); }
}
// expect: i32
// expect: i64
// expect: 0
