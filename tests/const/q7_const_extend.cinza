// Q7: Lists.extend e Lists.sorted copiam os números: a lista const não é compartilhada.
import Lists;
fn main() {
  const list<i32> a = [3, 1];
  list<i32> m = [0];
  Lists.extend(m, a);
  list<i32> s = Lists.sorted(a);
  s.add(9);
  m.add(2);
  print(a, m, s);
}
// expect: [3, 1] [0, 3, 1, 2] [1, 3, 9]
