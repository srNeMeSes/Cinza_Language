// interface: list<Circulo> não vira list<Forma> (senão a função poderia pôr um Retangulo nela).
interface Forma {
  fn area() -> decimal;
  fn nome() -> string;
}
class Circulo : Forma {
  decimal r = 1.0;
  pub {
    Circulo(decimal raio) { r = raio; }
    fn area() -> decimal { return 3.0 * r * r; }
    fn nome() -> string { return "círculo"; }
    fn raio() -> decimal { return r; }
  }
}
class Retangulo : Forma {
  decimal a = 1.0;
  decimal b = 1.0;
  pub {
    Retangulo(decimal x, decimal y) { a = x; b = y; }
    fn area() -> decimal { return a * b; }
    fn nome() -> string { return "retângulo"; }
  }
}
fn total(list<Forma> formas) -> decimal { return 0.0; }
fn main() {
  list<Circulo> cs = [new Circulo(1.0)];
  print(total(cs));
}
// expect-error: Argumento 1 de 'total': esperado 'list<Forma>', mas recebeu 'list<Circulo>'
