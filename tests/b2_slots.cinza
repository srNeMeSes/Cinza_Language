// B2: resolução em slots — sombra em blocos, redeclaração em laço, recursão, parâmetro × campo,
// campo que usa outro campo, iterador e erro do except.
const i64 BASE = 10;
class Caixa {
  i64 valor = BASE;
  i64 dobro = valor * 2;
  pub {
    fn soma(i64 extra) -> i64 { return extra + dobro; }
    fn campo() -> i64 { return valor; }
  }
}
struct Ponto { i64 x = 1; i64 y = 2; }
fn conta(i64 n) -> i64 {
  i64 local = n;
  if (n > 0) {
    i64 outro = 100;
    outro += conta(n - 1);
    local += outro;
  }
  return local;
}
fn main() {
  i64 x = 1;
  if (true) {
    i64 y = 2;
    x += y;
  }
  print(x);
  for (i64 i in range(0, 3)) {
    list<i64> acc;
    acc.add(i);
    print(acc.size());
  }
  for (i64 i in [1, 2]) { x += i; }
  print(x);
  print(conta(3));
  Caixa c = new Caixa();
  print(c.soma(1), c.campo());
  Ponto p = new Ponto();
  p.y = 5;
  print(p.x, p.y);
  try {
    throw ValueError("a");
  } except (ValueError e) {
    i64 z = 3;
    print(e.message, z);
  }
  print(x + BASE);
}
// expect: 3
// expect: 1
// expect: 1
// expect: 1
// expect: 6
// expect: 306
// expect: 21 10
// expect: 1 5
// expect: a 3
// expect: 16
