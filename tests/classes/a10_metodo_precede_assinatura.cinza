// A10: a checagem de tipos também usa o método (assinatura diferente da global).
fn soma(i64 a, i64 b) -> i64 { return a + b; }
class C {
  i64 base = 10;
  pub {
    fn soma(i64 a) -> i64 { return base + a; }
    fn usa() -> i64 { return soma(5); }
  }
}
fn main() {
  C c = new C();
  print(c.usa(), soma(1, 2));
}
// expect: 15 3
