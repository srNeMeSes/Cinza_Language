// B4 (regressão): return atravessa blocos, if, while, for e chamadas aninhadas do mesmo jeito que antes.
class Busca {
  list<i64> itens = [4, 8, 15, 16];
  pub {
    fn indice(i64 alvo) -> i64 {
      i64 i = 0;
      for (i64 x in itens) {
        if (x == alvo) { return i; }
        i = i + 1;
      }
      return -1;
    }
  }
}
fn primeiroPar(list<i64> l) -> i64 {
  i64 i = 0;
  while (i < l.size()) {
    { if (l[i] % 2 == 0) { return l[i]; } }
    i = i + 1;
  }
  return -1;
}
fn classifica(i64 n) -> string {
  if (n < 0) { return "negativo"; } else { if (n == 0) { return "zero"; } }
  return "positivo";
}
fn somaAte(i64 n) -> i64 { if (n == 0) { return 0; } return n + somaAte(n - 1); }
fn externo(i64 n) -> i64 { return somaAte(n) + primeiroPar([1, 3, n]); }
fn avisa(i64 n) {
  for (i64 x in [1, 2, 3]) {
    if (x == n) { print("achou", x); return; }
  }
  print("nao achou");
}
fn main() {
  Busca b = new Busca();
  print(b.indice(15), b.indice(99));
  print(primeiroPar([1, 3, 6, 8]), primeiroPar([1, 3]));
  print(classifica(-2), classifica(0), classifica(5));
  print(externo(4));
  avisa(2);
  avisa(7);
  i64 total = 0;
  for (i64 x in [1, 2, 3]) { total = total + somaAte(x); }
  print(total);
}
// expect: 2 -1
// expect: 6 -1
// expect: negativo zero positivo
// expect: 14
// expect: achou 2
// expect: nao achou
// expect: 10
