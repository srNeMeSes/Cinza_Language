// C2: for sobre dict<K,V> com iterador pair<K,V>, em ordem de chave.
fn main() {
  dict<string, i64> d = {{"banana", 2}, {"abacaxi", 1}, {"caju", 3}};
  for (pair<string, i64> p in d) {
    print(p.first, p.second);
  }
  i64 total = 0;
  for (var p in d) { total += p.second; }
  print(total);
}
// expect: banana 2
// expect: abacaxi 1
// expect: caju 3
// expect: 6
