// C1: and, or e not são sinônimos de &&, || e !, e podem ser misturados.
fn main() {
  print(true and false, true or false, not true);
  print(not false && true, false || not false);
  int x = 5;
  print(x > 1 and x < 10, not (x == 5) or x == 5);
}
// expect: false true false
// expect: true true
// expect: true true
