// Seção M (revê a revisão I e a seção K): ponto flutuante que estoura lança
// OverflowError, como inteiro — infinito e NaN não existem na Cinza. Vale para
// f64 e f32, nas contas e em Lists.sum/product.
import Lists;
fn main() {
  f64 d = 10.0ff;
  try {
    for (i64 i in range(0, 400)) { d = d * 10.0ff; }
  } except (OverflowError e) {
    print(e.kind, e.message);
  }
  f32 f = 10.0f;
  try {
    for (i64 i in range(0, 40)) { f = f * 10.0f; }
  } except (OverflowError e) {
    print(e.kind, e.message);
  }
  list<f64> grandes = [.0ff, .0ff];
  try { print(Lists.sum(grandes)); } except (OverflowError e) { print(e.message); }
  try { print(Lists.product(grandes)); } except (OverflowError e) { print(e.message); }
  list<f32> g32 = [300000000000000000000000000000000000000.f, 300000000000000000000000000000000000000.f];
  try { print(Lists.sum(g32)); } except (OverflowError e) { print(e.message); }
}
// expect: OverflowError 9.999999999999998e+307 * 10 excede a faixa de f64
// expect: OverflowError 1.0000001e+38 * 10 excede a faixa de f32
// expect: a soma de 'sum' excede a faixa de f64
// expect: o produto de 'product' excede a faixa de f64
// expect: a soma de 'sum' excede a faixa de f32
