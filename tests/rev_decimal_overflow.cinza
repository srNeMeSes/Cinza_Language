// Seção K: ponto flutuante segue o IEEE 754: estourar dá inf (e inf - inf dá
// nan), sem erro (antes, a revisão I lançava OverflowError). Inteiro continua
// com OverflowError.
import Lists;
fn main() {
  f64 d = 10.0ff;
  for (i64 i in range(0, 400)) { d = d * 10.0ff; }
  print(d, -d, d - d);
  f32 f = 10.0f;
  for (i64 i in range(0, 40)) { f = f * 10.0f; }
  print(f, type(f));
  list<f64> grandes = [.0ff, .0ff];
  print(Lists.sum(grandes), Lists.product(grandes));
}
// expect: inf -inf nan
// expect: inf f32
// expect: inf inf
