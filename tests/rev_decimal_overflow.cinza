// Revisão: decimal que estoura lança OverflowError, como int (antes saía inf e depois nan).
import Lists;
fn main() {
  decimal d = 10.0;
  try {
    for (int i in range(0, 400)) { d = d * 10.0; }
  } except (OverflowError e) {
    print(e.kind, e.message);
  }
  list<decimal> grandes = [.0, .0];
  try { print(Lists.sum(grandes)); } except (OverflowError e) { print(e.message); }
}
// expect: OverflowError 9.999999999999998e+307 * 10 excede a faixa de decimal
// expect: a soma de 'sum' excede a faixa de decimal
