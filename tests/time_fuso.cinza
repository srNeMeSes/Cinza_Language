// Time com fuso fixo (TZ=JST-9, Japão, UTC+9, sem horário de verão): o horário local é exato.
// Files.modified não pode depender do TZ (no Windows o _wstat o aplicava e a data saía deslocada).
// env: TZ=JST-9
import Time;
import Files;
fn main() {
  int t = Time.make_utc(2026, 10, 3, 18, 0, 0);
  print(Time.format(t, "dd/MM/yyyy HH:mm"), Time.hour(t), Time.day(t), Time.weekday(t), Time.weekday_utc(t));
  print(Time.make(2026, 10, 4, 3) == t, Time.parse("04/10/2026 03:00", "dd/MM/yyyy HH:mm") == t);
  print(Time.days_between(Time.make_utc(2026, 10, 3, 14), Time.make_utc(2026, 10, 3, 16)));
  str a = "tests/_tmp_time_fuso.txt";
  Files.write(a, "x");
  int dif = Files.modified(a) - Time.now();
  print(dif > -5 && dif < 5);
  Files.delete(a);
}
// expect: 04/10/2026 03:00 3 4 7 6
// expect: true true
// expect: 1
// expect: true
