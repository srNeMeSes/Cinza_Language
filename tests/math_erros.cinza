// Math (seção K): ponto flutuante segue o IEEE 754 — fora do domínio dá nan,
// polo dá -inf/inf e grande demais dá inf, sem erro (antes, G2: ValueError e
// OverflowError). Continuam erro: inteiro que não cabe, nan/inf para inteiro e
// argumentos inválidos.
import Math;
fn main() {
  print(Math.asin(2.ff), Math.acos(-1.5ff), Math.log10(0.ff), Math.log2(-1.ff));
  print(Math.log_base(8.ff, 1.ff), Math.log_base(-8.ff, 2.ff), Math.exp(1000.ff), Math.sinh(1000.ff));
  f64 enorme = Math.pow(10.ff, 308.ff) * 1.5ff;
  print(Math.hypot(enorme, enorme), Math.pow(0.ff, -1.ff), Math.sqrt(-0.ff), Math.tan(Math.pi / 2.ff) > 1000000.ff);
  try { print(Math.trunc(Math.pow(10.ff, 30.ff))); } except (OverflowError e) { print(e.message); }
  try { print(Math.floor(Math.nan)); } except (ValueError e) { print(e.message); }
  try { print(Math.round(-Math.inf)); } except (ValueError e) { print(e.message); }
  try { print(Math.round_to(1.5ff, -1)); } except (ValueError e) { print(e.message); }
  try { print(Math.factorial(-1)); } except (ValueError e) { print(e.message); }
  try { print(Math.factorial(21)); } except (OverflowError e) { print(e.message); }
  try { print(Math.gcd(-9223372036854775807 - 1, 0)); } except (OverflowError e) { print(e.message); }
  try { print(Math.lcm(9223372036854775807, 2)); } except (OverflowError e) { print(e.message); }
  try { print(Math.lcm(65536, 65537)); } except (OverflowError e) { print(e.message); }
  try { print(Math.clamp(5, 10, 0)); } except (ValueError e) { print(e.message); }
}
// expect: nan nan -inf nan
// expect: inf nan inf inf
// expect: inf inf -0 true
// expect: resultado de 'trunc' fora do intervalo de i64
// expect: 'floor' de nan não tem valor inteiro
// expect: 'round' de -inf não tem valor inteiro
// expect: o número de casas de 'round_to' não pode ser negativo
// expect: 'factorial' de número negativo
// expect: 'factorial(21)' não cabe em i64 (o máximo é 20)
// expect: resultado de 'gcd' fora do intervalo de i64
// expect: resultado de 'lcm' fora do intervalo de i64
// expect: resultado de 'lcm' fora do intervalo de i32
// expect: em 'clamp' o mínimo não pode ser maior que o máximo
