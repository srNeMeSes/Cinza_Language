// Math: fora do domínio lança ValueError; resultado grande demais lança OverflowError (seção M:
// infinito e NaN não existem). Com f32, o resultado precisa caber em f32.
import Math;
fn main() {
  try { print(Math.asin(2.ff)); } except (ValueError e) { print(e.message); }
  try { print(Math.acos(-1.5ff)); } except (ValueError e) { print(e.message); }
  try { print(Math.log10(0.ff)); } except (ValueError e) { print(e.message); }
  try { print(Math.log2(-1.ff)); } except (ValueError e) { print(e.message); }
  try { print(Math.log_base(8.ff, 1.ff)); } except (ValueError e) { print(e.message); }
  try { print(Math.log_base(-8.ff, 2.ff)); } except (ValueError e) { print(e.message); }
  try { print(Math.exp(1000.ff)); } except (OverflowError e) { print(e.message); }
  try { print(Math.sinh(1000.ff)); } except (OverflowError e) { print(e.message); }
  f64 enorme = Math.pow(10.ff, 308.ff) * 1.5ff;
  try { print(Math.hypot(enorme, enorme)); } except (OverflowError e) { print(e.kind); }
  try { print(Math.trunc(Math.pow(10.ff, 30.ff))); } except (OverflowError e) { print(e.message); }
  try { print(Math.round_to(1.5ff, -1)); } except (ValueError e) { print(e.message); }
  try { print(Math.factorial(-1)); } except (ValueError e) { print(e.message); }
  try { print(Math.factorial(21)); } except (OverflowError e) { print(e.message); }
  try { print(Math.gcd(-9223372036854775807 - 1, 0)); } except (OverflowError e) { print(e.message); }
  try { print(Math.lcm(9223372036854775807, 2)); } except (OverflowError e) { print(e.message); }
  try { print(Math.clamp(5, 10, 0)); } except (ValueError e) { print(e.message); }
  try { print(Math.sqrt(-4.f)); } except (ValueError e) { print(e.message); }
  try { print(Math.exp(100.f)); } except (OverflowError e) { print(e.message); }
  try { print(Math.pow(10.f, 39.f)); } except (OverflowError e) { print(e.message); }
  try { print(Math.lcm(65536, 65537)); } except (OverflowError e) { print(e.message); }
  print(Math.exp(88.f) > 1000000.f, type(Math.exp(1.f)), Math.sqrt(-0.ff));
}
// expect: 'asin' só é definido de -1 a 1
// expect: 'acos' só é definido de -1 a 1
// expect: 'log10' só é definido para números positivos
// expect: 'log2' só é definido para números positivos
// expect: a base de 'log_base' precisa ser positiva e diferente de 1
// expect: 'log_base' só é definido para números positivos
// expect: resultado de 'exp' grande demais
// expect: resultado de 'sinh' grande demais
// expect: OverflowError
// expect: resultado de 'trunc' fora do intervalo de i64
// expect: o número de casas de 'round_to' não pode ser negativo
// expect: 'factorial' de número negativo
// expect: 'factorial(21)' não cabe em i64 (o máximo é 20)
// expect: resultado de 'gcd' fora do intervalo de i64
// expect: resultado de 'lcm' fora do intervalo de i64
// expect: em 'clamp' o mínimo não pode ser maior que o máximo
// expect: 'sqrt' de número negativo
// expect: resultado de 'exp' não cabe em f32
// expect: resultado de 'pow' não cabe em f32
// expect: resultado de 'lcm' fora do intervalo de i32
// expect: true f32 -0
