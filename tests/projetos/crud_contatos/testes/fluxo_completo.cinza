// O CRUD inteiro pelo menu, com a entrada simulada (diretivas stdin), gravando num
// arquivo de texto; depois o arquivo é relido numa agenda nova.
// Este arquivo está em testes/: os imports partem da raiz (o czm.mod da pasta acima).
import servicos.agenda as ag;
import dados.repositorio as repo;
import ui.console;
import Files;

fn main() {
  string arquivo = "tests/projetos/crud_contatos/testes/_tmp_fluxo.txt";
  if (Files.exists(arquivo)) { Files.delete(arquivo); }
  console.executa(new ag.Agenda(new repo.ArquivoTexto(arquivo)));
  print("--- arquivo ---");
  for (string linha in Files.lines(arquivo)) { print(linha); }
  print("--- relido ---");
  console.executa(new ag.Agenda(new repo.ArquivoTexto(arquivo)));
  Files.delete(arquivo);
}
