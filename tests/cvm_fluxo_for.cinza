// CVM etapa 3: for sobre range, string e com conversão para f64; break/continue no for; laços aninhados.
fn main() {
  i64 soma = 0;
  for (i64 i in range(0, 10)) {
    if (i == 2) { continue; }
    if (i == 6) { break; }
    soma += i;
  }
  print(soma);
  string invertido = "";
  for (string c in "ação") { invertido = c + invertido; }
  print(invertido);
  f64 total = 0.0;
  for (f64 x in range(1, 4)) { total += x / 2; }
  print(total);
  i64 pares = 0;
  for (i64 a in range(0, 4)) {
    for (i64 b in range(0, 4)) {
      if (b > a) { break; }
      pares += 1;
    }
  }
  print(pares);
}
// expect: 13
// expect: oãça
// expect: 3
// expect: 10
