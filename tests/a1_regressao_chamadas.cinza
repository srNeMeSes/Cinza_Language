// A1 (regressão): recursão, método chamando método, construtor e for continuam funcionando com frames.
class C {
  int v = 1;
  pub {
    C(int p) { v = p; }
    fn soma(int a) -> int { return a + v + ajuda(); }
    fn ajuda() -> int { return v * 10; }
  }
}
fn fib(int n) -> int { if (n < 2) { return n; } return fib(n - 1) + fib(n - 2); }
fn main() {
  C c = new C(3);
  print(c.soma(100));
  print(fib(15));
  for (int i in [1, 2]) { print(i); }
}
// expect: 133
// expect: 610
// expect: 1
// expect: 2
