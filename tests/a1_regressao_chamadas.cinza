// A1 (regressão): recursão, método chamando método, construtor e for continuam funcionando com frames.
class C {
  i64 v = 1;
  pub {
    C(i64 p) { v = p; }
    fn soma(i64 a) -> i64 { return a + v + ajuda(); }
    fn ajuda() -> i64 { return v * 10; }
  }
}
fn fib(i64 n) -> i64 { if (n < 2) { return n; } return fib(n - 1) + fib(n - 2); }
fn main() {
  C c = new C(3);
  print(c.soma(100));
  print(fib(15));
  for (i64 i in [1, 2]) { print(i); }
}
// expect: 133
// expect: 610
// expect: 1
// expect: 2
