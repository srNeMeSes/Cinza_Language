// Módulo auxiliar dos testes c5 (não é teste: fica fora de tests/*.cinza).
pub const i64 LADO = 3;
const i64 SEGREDO = 7;

pub struct Ponto { i64 x = 0; i64 y = 0; }

pub class Contador {
  i64 n = 0;
  pub {
    fn inc() { n += 1; }
    fn valor() -> i64 { return n; }
  }
}

pub error ForaDaArea;

fn dobro(i64 v) -> i64 { return v * 2; }

pub fn area(i64 l) -> i64 { return l * l; }
pub fn dobroDoLado() -> i64 { return dobro(LADO); }
pub fn origem() -> Ponto { return new Ponto(); }
pub fn valida(i64 v) {
  if (v > 10) { throw ForaDaArea("valor alto"); }
}
pub fn segredo() -> i64 { return SEGREDO; }
