// Módulo auxiliar dos testes cvm_modulo_* (etapa 8 da CVM).
pub const i64 LIMITE = 10;
const i64 SECRETO = LIMITE * 2;
pub const f64 TAXA = LIMITE / 4.0;
pub error Ruim;
pub struct Par { i64 a = 1; i64 b = LIMITE; }
pub enum Nivel { Baixo, Alto }
pub interface Medida { fn valor() -> i64; }
pub class Caixa : Medida {
  i64 n = SECRETO;
  pub {
    Caixa(i64 x) { n += x; }
    fn valor() -> i64 { return n; }
    fn falha() { throw Ruim("da caixa"); }
  }
}
pub fn divide(i64 a, i64 b) -> i64 { return a / b; }
pub fn nivel(i64 x) -> Nivel { if (x > LIMITE) { return Nivel.Alto; } return Nivel.Baixo; }
