// Seção K: ponto flutuante segue o IEEE 754, sem erro: inf, -inf, nan e -0.
fn main() {
  f64 zero = 0.ff;
  f64 inf = 1.ff / zero;
  f64 nan = zero / zero;
  print(inf, -inf, nan, -zero, 1.ff / -inf);
  print(nan == nan, nan != nan, nan < 1.ff, nan > 1.ff, inf > 1000000.ff, -zero == zero);
  f32 fz = 0.f;
  f32 big = 1000000.f;
  print(1.f / fz, fz / fz, big * big * big * big * big * big * big, type(fz / fz));
  print(cast<f32>(inf), cast<f64>(1.f / fz), inf - inf);
  printf("{inf:.2f} {nan:8.1f} {-inf}");
}
// expect: inf -inf nan -0 -0
// expect: false true false false true true
// expect: inf nan inf f32
// expect: inf inf nan
// expect: inf      nan -inf
