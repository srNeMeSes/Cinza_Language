// C4/B6: erro não tratado imprime tipo, mensagem e stack trace (da chamada mais interna para fora).
error Falha;
fn nivel2() { throw Falha("deu ruim"); }
fn nivel1() { nivel2(); }
fn main() {
    nivel1();
}
