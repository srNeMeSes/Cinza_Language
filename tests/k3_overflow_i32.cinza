// Seção K: i32 estoura na faixa de 32 bits (OverflowError), com e sem constante embutida.
fn tenta(i32 a, i32 b, i32 qual) {
  try {
    if (qual == 0) { print(a + b); }
    if (qual == 1) { print(a - b); }
    if (qual == 2) { print(a * b); }
    if (qual == 3) { print(a / b); }
    if (qual == 4) { print(-a); }
  } except (OverflowError e) { print(e.message); }
}
fn main() {
  tenta(2147483647, 1, 0);
  tenta(-2147483648, 1, 1);
  tenta(65536, 65536, 2);
  tenta(-2147483648, -1, 3);
  tenta(-2147483648, 0, 4);
  i32 x = 2147483600;
  try { x += 100; } except (OverflowError e) { print(e.message); }
  try { print(x * 2); } except (OverflowError e) { print(e.message); }
  print(x + 47, cast<i64>(x) * 2, -2147483648 % -1, 7 % -1);
  try { print(x / 0); } except (ZeroDivisionError e) { print(e.message); }
}
// expect: 2147483647 + 1 excede a faixa de i32 (-2147483648 a 2147483647)
// expect: -2147483648 - 1 excede a faixa de i32 (-2147483648 a 2147483647)
// expect: 65536 * 65536 excede a faixa de i32 (-2147483648 a 2147483647)
// expect: -2147483648 / -1 excede a faixa de i32 (-2147483648 a 2147483647)
// expect: -(-2147483648) excede a faixa de i32 (-2147483648 a 2147483647)
// expect: 2147483600 + 100 excede a faixa de i32 (-2147483648 a 2147483647)
// expect: 2147483600 * 2 excede a faixa de i32 (-2147483648 a 2147483647)
// expect: 2147483647 4294967200 0 0
// expect: divisão por zero
