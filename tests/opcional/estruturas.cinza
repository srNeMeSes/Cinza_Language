// Q1b: o opcional em campos (nasce null), structs (o campo T? não é obrigatório), genéricos
// (T? como resultado; o T deduzido de um T?), listas e dicts de opcionais, interfaces
import Lists as L;

interface Forma { fn area() -> f64; }
class Quadrado : Forma {
  f64 lado = 2.ff;
  pub { fn area() -> f64 { return lado * lado; } }
}

class No {
  i32 valor = 0;
  No? prox;
  pub {
    No(i32 v) { valor = v; }
    fn liga(No n) { prox = n; }
    fn tem() -> bool { return prox != null; }
  }
}

struct Pessoa { string nome = "x"; i32? idade; }
struct Caixa[T] { T? conteudo; i32 n = 0; }

fn primeiro[T](list<T> l) -> T? {
  if (l.size() == 0) { return null; }
  return l[0];
}

fn ou[T](T? x, T padrao) -> T { return x else padrao; }

fn main() {
  No x = new No(1);
  print(x.tem());
  x.liga(new No(2));
  print(x.tem());
  Pessoa p = new Pessoa(nome: "ana");
  Pessoa q = new Pessoa("bia", 30);
  print(p, q, p.idade == null, q.idade == 30);
  Caixa[string] k = new Caixa[string](n: 3);
  print(k.conteudo, k.n, type(k.conteudo));
  print(primeiro([3, 4]), primeiro(["a"]), primeiro(L.slice(["z"], 0, 0)) else "vazio");
  string? s = "s";
  print(ou(s, "p"), ou(null, 7), ou(primeiro(L.slice([1], 0, 0)), 9));
  list<i32?> l = [1, null, 3];
  print(l, l[1] == null, l[0] else 0, L.contains(l, null));
  dict<string, i32?> d = {{"a", 1}, {"b", null}};
  print(d, d["b"] == null);
  Forma? f = new Quadrado();
  Forma? g;
  print(f == null, g == null, type(f));
  printf("{q.idade} anos, {p.idade}");
}
// expect: false
// expect: true
// expect: Pessoa{nome: "ana", idade: null} Pessoa{nome: "bia", idade: 30} true true
// expect: null 3 string?
// expect: 3 a vazio
// expect: s 7 9
// expect: [1, null, 3] true 1 true
// expect: {"a": 1, "b": null} true
// expect: false true Forma?
// expect: 30 anos, null
