// Q1b: o opcional guarda o valor com a regra da spec 5.1 — o struct é copiado ao entrar (e
// ao sair), list e objetos continuam compartilhados; strings reatribuídas num laço
struct Ponto { i32 x = 0; i32 y = 0; }
class Guarda {
  string? nome;
  Ponto? p;
  list<string>? l;
  pub {
    fn poe(string n) { nome = n + "!"; }
    fn ponto(Ponto q) { p = q; }
    fn lista(list<string> x) { l = x; }
    fn mostra() -> string {
      return (nome else "-") + " " + cast<string>((p else new Ponto()).x) + " " + cast<string>((l else ["?", "?", "?"]).size());
    }
  }
}
fn troca(string? s) -> string? {
  s = (s else "") + "x";
  return s;
}
fn main() {
  Ponto p = new Ponto(1, 2);
  Ponto? a = p;
  p.x = 9;
  print(a, p);
  Ponto b = a else new Ponto();
  b.y = 7;
  print(a, b);
  string? s;
  for (i32 i in range(0, 1000)) { s = (s else "") + "a"; }
  print((s else "").size());
  Guarda g = new Guarda();
  print(g.mostra());
  g.poe("ana");
  g.ponto(p);
  g.poe("bia");
  list<string> lst = ["u"];
  g.lista(lst);
  lst.add("v");
  print(g.mostra());
  print(troca("q"), troca(null));
  list<string?> nomes;
  for (i32 i in range(0, 3)) {
    nomes.add(null);
    nomes.add("n" + cast<string>(i));
  }
  print(nomes);
  dict<string, Ponto?> d = {{"a", p}, {"b", null}};
  p.y = 100;
  print(d);
}
// expect: Ponto{x: 1, y: 2} Ponto{x: 9, y: 2}
// expect: Ponto{x: 1, y: 2} Ponto{x: 1, y: 7}
// expect: 1000
// expect: - 0 3
// expect: bia! 9 2
// expect: qx x
// expect: [null, "n0", null, "n1", null, "n2"]
// expect: {"a": Ponto{x: 9, y: 2}, "b": null}
