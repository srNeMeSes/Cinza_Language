// Varredura L: com nan, a ordenação tem ordem total — nan fica depois de tudo,
// inclusive de inf (antes a lista saía fora de ordem: o < do IEEE não é uma
// ordem válida para ordenar). min/max propagam nan, nos dois lados.
import Lists;
import Math;
fn main() {
  list<f64> l = [3.ff, Math.nan, 1.ff, Math.nan, 2.ff, -Math.inf, Math.inf, 0.ff];
  Lists.sort(l);
  print(l);
  print(Lists.sorted([2.ff, Math.nan, 1.ff]), Lists.sorted([Math.nan, 1.f, 0.5f]));
  list<f64> m = [Math.nan, 5.ff, 1.ff];
  Lists.sort_desc(m);
  print(m);
  list<string> nomes = ["c", "a", "b"];
  list<f64> chaves = [Math.nan, 1.ff, 0.ff];
  Lists.sort_by(nomes, chaves);
  print(nomes);
  print(Lists.min([2.ff, Math.nan, 1.ff]), Lists.max([2.ff, Math.nan, 1.ff]), Lists.min([2.ff, 1.ff]));
  print(Math.min(Math.nan, 1.ff), Math.min(1.ff, Math.nan), Math.max(Math.nan, 1.ff), Math.max(1.ff, Math.nan));
  print(Math.min(1.f, 2.f), Math.max(-0.ff, 0.ff), Math.min(3, 2));
}
// expect: [-inf, 0, 1, 2, 3, inf, nan, nan]
// expect: [1, 2, nan] [0.5, 1, nan]
// expect: [nan, 5, 1]
// expect: ["b", "a", "c"]
// expect: nan nan 1
// expect: nan nan nan nan
// expect: 1 -0 2
