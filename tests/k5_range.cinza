// Seção K: range segue os argumentos — i32 com i32, i64 com i64 — e o for alarga.
fn main() {
  print(type(range(0, 3)), type(range(cast<i64>(0), 3)), range(0, 10, 4), range(5, 0, -2));
  i64 n = 3;
  print(type(range(0, n)), range(0, n));
  for (var i in range(0, 2)) { print(i, type(i)); }
  for (i64 j in range(0, 2)) { print(j, type(j)); }
  for (i32 k in range(2147483645, 2147483647)) { print(k); }
  for (i32 k in range(-2147483647, -2147483648, -1)) { print(k); }
  print(range(2147483645, 2147483647), range(-2147483647, -2147483648, -1));
  list<i32> l = range(0, 3);
  list<i64> g = range(n, 5);
  print(l, g);
}
// expect: list<i32> list<i64> [0, 4, 8] [5, 3, 1]
// expect: list<i64> [0, 1, 2]
// expect: 0 i32
// expect: 1 i32
// expect: 0 i64
// expect: 1 i64
// expect: 2147483645
// expect: 2147483646
// expect: -2147483647
// expect: [2147483645, 2147483646] [-2147483647]
// expect: [0, 1, 2] [3, 4]
