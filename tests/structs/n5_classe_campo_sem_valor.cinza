// 4.6 / Q1a: na classe, um campo sem valor inicial é obrigatório, e o construtor o atribui (antes
// do Q1a, a classe exigia o valor na declaração)
class Conta {
  string dono;
  pub {
    Conta(string d) { dono = d; }
    fn nome() -> string { return dono; }
  }
}
fn main() { print(new Conta("ana").nome()); }
// expect: ana
