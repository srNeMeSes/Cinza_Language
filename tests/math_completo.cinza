// Math: trigonometria, potências, logaritmos, arredondamento, inteiros e comparação de decimais.
import Math;
fn main() {
  print(Math.tau == 2.ff * Math.pi, Math.degrees(Math.pi), Math.radians(180.ff) == Math.pi);
  print(Math.round_to(Math.tan(Math.pi / 4.ff), 9), Math.asin(1.ff) == Math.pi / 2.ff, Math.acos(1.ff), Math.atan(0.ff));
  print(Math.degrees(Math.atan2(1.ff, 1.ff)), Math.degrees(Math.atan2(-1.ff, -1.ff)));
  print(Math.sinh(0.ff), Math.cosh(0.ff), Math.tanh(0.ff));
  print(Math.cbrt(27.ff), Math.cbrt(-8.ff), Math.exp(0.ff), Math.log10(1000.ff), Math.log2(1024.ff), Math.log_base(81.ff, 3.ff));
  print(Math.hypot(3.ff, 4.ff));
  // trunc corta em direção ao zero; floor desce
  print(Math.trunc(2.7ff), Math.trunc(-2.7ff), Math.floor(-2.7ff));
  // round_to arredonda o número como é escrito: metade se afasta do zero
  print(Math.round_to(2.675ff, 2), Math.round_to(-2.675ff, 2), Math.round_to(3.14159ff, 3), Math.round_to(2.5ff, 0));
  print(Math.round_to(9.995ff, 2), Math.round_to(0.004ff, 2), Math.round_to(-0.004ff, 2), Math.round_to(1.5ff, 10), Math.round_to(7.ff, 2));
  print(Math.gcd(12, 18), Math.gcd(-12, 18), Math.gcd(0, 5), Math.gcd(0, 0));
  print(Math.lcm(4, 6), Math.lcm(-4, 6), Math.lcm(0, 7));
  print(Math.is_even(4), Math.is_even(-3), Math.is_odd(-3), Math.is_odd(0));
  print(Math.sign(-5), Math.sign(0), Math.sign(2.5ff), Math.sign(-0.1ff));
  print(Math.clamp(15, 0, 10), Math.clamp(-3, 0, 10), Math.clamp(5, 0, 10), Math.clamp(1.5ff, 0.0ff, 1.0ff));
  print(Math.factorial(0), Math.factorial(5), Math.factorial(20));
  print(Math.is_prime(2), Math.is_prime(1), Math.is_prime(-7), Math.is_prime(97), Math.is_prime(91));
  print(Math.is_prime(9223372036854775783), Math.is_prime(9223372036854775807), Math.is_prime(3215031751));
  print(0.1ff + 0.2ff == 0.3ff, Math.is_close(0.1ff + 0.2ff, 0.3ff), Math.is_close(1.0ff, 1.001ff), Math.is_close(0.1ff + 0.2ff - 0.3ff, 0.ff));
}
// expect: true 180 true
// expect: 1 true 0 0
// expect: 45 -135
// expect: 0 1 0
// expect: 3 -2 1 3 10 4
// expect: 5
// expect: 2 -2 -3
// expect: 2.68 -2.68 3.142 3
// expect: 10 0 0 1.5 7
// expect: 6 6 5 0
// expect: 12 12 0
// expect: true false true false
// expect: -1 0 1 -1
// expect: 10 0 5 1
// expect: 1 120 2432902008176640000
// expect: true false false true false
// expect: true false false
// expect: false true false true
