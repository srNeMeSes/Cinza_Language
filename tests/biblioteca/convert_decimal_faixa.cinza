// Texto grande demais para f64 lança OverflowError (o cast e o Convert leem igual);
// pequeno demais vira 0, como num cálculo com f64.
import Convert as cv;
fn main() {
  try { print(cast<f64>("1e999")); } except (OverflowError e) { print(e.message); }
  try { print(cast<f64>("-1e400")); } except (OverflowError e) { print(e.message); }
  print(cast<f64>("1e-999"), cast<f64>("-1e-400"), cast<f64>("1e308") > 0.ff);
  print(cv.to_f64("1e999") != null, cv.to_f64("1e-999") != null, cv.to_f64("1e999") else -1.ff);
  print(cv.to_f32("1e39") != null, cv.to_f64("1e39") != null, cv.to_f32("1e39") else 0.f);
}
// expect: cast<f64>("1e999"): o valor não cabe em f64
// expect: cast<f64>("-1e400"): o valor não cabe em f64
// expect: 0 -0 true
// expect: false true -1
// expect: false true 0
