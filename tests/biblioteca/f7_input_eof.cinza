// Fase 7 / Q1b: no fim da entrada, input dá null — o while com declaração lê até o fim.
// stdin: um
// stdin: dois
fn main() {
  i32 n = 0;
  while (string linha = input("")) {
    n += 1;
    print(n, linha);
  }
  print(input("") == null, input("") else "fim");
}
// expect: 1 um
// expect: 2 dois
// expect: true fim
