// Seção K: o Convert fica com o que o cast não faz — a conversão que pode falhar sem erro
// (to_* dá um T?; Q1b), bool e bases — e lê o texto exatamente como o cast.
import Convert as cv;
fn main() {
  print(cv.to_i32("42") != null, cv.to_i32("3000000000") != null, cv.to_i64("3000000000") != null, cv.to_i64("1.5") != null);
  print(cv.to_f32("1e39") != null, cv.to_f64("1e39") != null, cv.to_f64("inf") != null, cv.to_f64("nan") != null, cv.to_f64(" 1") != null);   // sem inf/nan
  print(cv.to_i32("7") else 0, type(cv.to_i32("7") else 0), cv.to_i32("x") else -1, cv.to_i64("9000000000") else 0);
  print(cv.to_f32("0.1") else 0.f, type(cv.to_f32("0.1") else 0.f), cv.to_f64("2.5") else 0.ff, cv.to_f64("?") else -1.ff);
  print(cv.to_bool("true") != null, cv.to_bool("sim") else false, cv.to_hex(255), cv.from_base("z", 36));
  i32 n = 10;
  print(cv.to_binary(n), cv.to_base(n, 3));
}
// expect: true false true false
// expect: false true false false false
// expect: 7 i32 -1 9000000000
// expect: 0.1 f32 2.5 -1
// expect: true false ff 35
// expect: 1010 101
