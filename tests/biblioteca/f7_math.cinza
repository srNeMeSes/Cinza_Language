// Fase 7: namespace Math — constantes e funções.
import Math;
fn main() {
  print(Math.sqrt(16.0ff), Math.sqrt(2.ff) > 1.41ff, Math.pow(2.ff, 10.ff));
  print(Math.abs(-3), Math.abs(-2.5ff));
  print(Math.floor(2.7ff), Math.ceil(2.1ff), Math.round(2.5ff), Math.round(-2.5ff), Math.floor(-0.5ff));
  print(Math.min(3, 7), Math.max(3, 7), Math.min(1.5ff, 0.5ff));
  print(Math.sin(0.0ff), Math.cos(0.0ff), Math.log(Math.e));
  print(Math.pi > 3.14159ff, Math.pi < 3.1416ff);
  i64 f = Math.floor(9.99ff);
  print(f + 1);
}
// expect: 4 true 1024
// expect: 3 2.5
// expect: 2 3 3 -3 -1
// expect: 3 7 0.5
// expect: 0 1 1
// expect: true true
// expect: 10
