// Fase 7 / seção K: texto inválido lança ValueError; número que não cabe, OverflowError.
import Convert;
fn main() {
  try { print(cast<i64>("12a")); } except (ValueError e) { print(e.message); }
  try { print(cast<i64>(" 1")); } except (ValueError e) { print(e.message); }
  try { print(cast<i64>("+-1")); } except (ValueError e) { print(e.message); }
  try { print(cast<i64>("99999999999999999999")); } except (OverflowError e) { print(e.message); }
  try { print(cast<i32>("3000000000")); } except (OverflowError e) { print(e.message); }
  try { print(cast<f64>("abc")); } except (ValueError e) { print(e.message); }
  try { print(cast<f64>("1.")); } except (ValueError e) { print(e.message); }
  try { print(Convert.to_bool("sim")); } except (ValueError e) { print(e.kind); }
}
// expect: cast<i64>("12a"): não é um número inteiro (só sinal e dígitos)
// expect: cast<i64>(" 1"): não é um número inteiro (só sinal e dígitos)
// expect: cast<i64>("+-1"): não é um número inteiro (só sinal e dígitos)
// expect: cast<i64>("99999999999999999999"): o valor não cabe em i64
// expect: cast<i32>("3000000000"): o valor não cabe em i32
// expect: cast<f64>("abc"): não é um número (ex.: 2.5, -3, 1e10)
// expect: cast<f64>("1."): não é um número (ex.: 2.5, -3, 1e10)
// expect: ValueError
