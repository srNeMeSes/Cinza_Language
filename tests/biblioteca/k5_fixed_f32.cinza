// Seção K: Strings.fixed com f32 arredonda a forma decimal do float (como {x:.2f}).
import Strings;
fn main() {
  f32 x = 2.675f;
  f64 y = cast<f64>(x);
  print(Strings.fixed(x, 2), Strings.fixed(y, 2), Strings.fixed(2.675ff, 2));
  printf("{x:.2f} {y:.2f}");
}
// expect: 2.68 2.67 2.68
// expect: 2.68 2.67
