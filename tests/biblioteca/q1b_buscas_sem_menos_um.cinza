// Q1b: as buscas que não acham lançam ValueError (não há -1); contains pergunta antes e
// positions dá todas as ocorrências (nenhuma: []).
import Strings as st;
import Lists as L;
import Regex as re;
fn main() {
  try { print(st.find("abc", "z")); } except (ValueError e) { print(e.message); }
  try { print(st.find_last("abc", "z")); } except (ValueError e) { print(e.message); }
  try { print(st.find_from("abcabc", "a", 4)); } except (ValueError e) { print(e.message); }
  try { print(L.index_of([1, 2], 3)); } except (ValueError e) { print(e.message); }
  try { print(L.last_index_of(["a"], "b")); } except (ValueError e) { print(e.message); }
  try { print(re.find("abc", "[0-9]+")); } except (ValueError e) { print(e.message); }
  print(st.find("ação", "ç"), st.find_last("abab", "ab"), st.find_from("abcabc", "a", 1), L.index_of([1, 2, 1], 1),
        L.last_index_of([1, 2, 1], 1), re.find("ab12", "[0-9]+"));
  print(st.positions("ação ação", "ç"), st.positions("aaaa", "aa"), st.positions("abc", "z"), st.count("aaaa", "aa"));
  try { print(st.positions("abc", "")); } except (ValueError e) { print(e.message); }
  string s = "nome: Ana";
  if (st.contains(s, ":")) { print(st.right(s, s.size() - st.find(s, ":") - 2)); }
}
// expect: 'find': "z" não aparece no texto
// expect: 'find_last': "z" não aparece no texto
// expect: 'find_from': "a" não aparece no texto a partir do índice 4
// expect: 'index_of': 3 não está na lista
// expect: 'last_index_of': b não está na lista
// expect: 'find': o padrão "[0-9]+" não casa com o texto
// expect: 1 2 3 0 2 2
// expect: [1, 6] [0, 2] [] 2
// expect: o trecho de 'positions' não pode ser vazio
// expect: Ana
