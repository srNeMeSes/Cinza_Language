// Env (Q3/Q1b): o ambiente do programa, só para ler — get dá um string? (null se a variável não
// existir) e all dá todas; os valores em UTF-8; nome vazio ou com '=' é ValueError.
// env: CINZA_TESTE_ENV=ação e água
import Env;
fn main() {
  print(Env.get("CINZA_TESTE_ENV"), Env.get("CINZA_TESTE_ENV") != null, Env.get("CINZA_NAO_EXISTE_Q3"));
  print(Env.get("CINZA_NAO_EXISTE_Q3") else "padrão", Env.get("CINZA_TESTE_ENV") else "x");
  dict<string, string> tudo = Env.all();
  print(tudo["CINZA_TESTE_ENV"], tudo.size() > 1);
  try { print(Env.get("")); } except (ValueError e) { print(e.message); }
  try { print(Env.get("A=B") else ""); } except (ValueError e) { print(e.message); }
}
// expect: ação e água true null
// expect: padrão ação e água
// expect: ação e água true
// expect: 'get': nome de variável de ambiente inválido: ''
// expect: 'get': nome de variável de ambiente inválido: 'A=B'
