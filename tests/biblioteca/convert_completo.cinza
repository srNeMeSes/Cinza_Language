// Convert: converter sem try (to_* dá um T?: null se o texto não for válido; Q1b) e bases numéricas.
// to_* aceita exatamente os mesmos textos que o cast<T>.
import Convert as cv;
fn main() {
  print(cv.to_i64("42") != null, cv.to_i64("+7") != null, cv.to_i64("-0") != null, cv.to_i64("") != null, cv.to_i64(" 1") != null, cv.to_i64("1.0") != null, cv.to_i64("99999999999999999999") != null);
  print(cv.to_f64("2.5") != null, cv.to_f64("-3") != null, cv.to_f64("1e3") != null, cv.to_f64("2,5") != null, cv.to_f64(".5") != null, cv.to_f64("1e999") != null);
  print(cv.to_bool("true") != null, cv.to_bool("false") != null, cv.to_bool("True") != null, cv.to_bool("1") != null);
  print(cv.to_i64("42") else 0, cv.to_i64("abc") else -1, cv.to_i64("99999999999999999999") else 0);
  f64 d = cv.to_f64("x") else 1.ff;
  print(cv.to_f64("2.5") else 0.0ff, d, type(d), cv.to_bool("false") else true, cv.to_bool("sim") else true);
  // bases: dígitos minúsculos, sem prefixo; negativo com '-'
  print(cv.to_hex(255), cv.to_binary(10), cv.to_octal(8), cv.to_base(35, 36), cv.to_base(0, 2), cv.to_hex(-255));
  print(cv.to_hex(-9223372036854775807 - 1), cv.to_binary(9223372036854775807).size());
  print(cv.from_base("ff", 16), cv.from_base("FF", 16), cv.from_base("-1010", 2), cv.from_base("+z", 36), cv.from_base("777", 8));
  print(cv.from_base("-8000000000000000", 16), cv.from_base("7fffffffffffffff", 16));
  print(cv.from_base(cv.to_base(123456789, 7), 7));
}
// expect: true true true false false false false
// expect: true true true false false false
// expect: true true false false
// expect: 42 -1 0
// expect: 2.5 1 f64 false true
// expect: ff 1010 10 z 0 -ff
// expect: -8000000000000000 63
// expect: 255 255 -10 35 511
// expect: -9223372036854775808 9223372036854775807
// expect: 123456789
