// CVM (otimização: for sobre range sem criar a lista): mesmos resultados do range comum — passo
// negativo, intervalo vazio, conversão para f64, break/continue, limite de i64 e argumentos
// avaliados uma vez, na ordem.
fn mostra(i64 n) -> i64 {
  print("arg", n);
  return n;
}
fn main() {
  i64 s = 0;
  for (i64 i in range(10, 0, -3)) { s = s * 100 + i; }
  print(s);
  for (i64 i in range(5, 5)) { print("nunca"); }
  for (i64 i in range(5, 0)) { print("nunca"); }
  f64 t = 0.0;
  for (f64 x in range(1, 4)) { t += x / 2; }
  print(t);
  i64 c = 0;
  for (i64 i in range(0, 100)) {
    if (i % 2 == 0) { continue; }
    if (i > 9) { break; }
    c += i;
  }
  print(c);
  i64 ultimo = 0;
  i64 voltas = 0;
  for (i64 i in range(9223372036854775805, 9223372036854775807, 1)) { ultimo = i; voltas += 1; }
  print(ultimo, voltas);
  for (i64 i in range(9223372036854775806, 9223372036854775807, 5)) { print("só um", i); }
  for (i64 i in range(mostra(1), mostra(3))) { print("volta", i); }
  i64 x = 7;
  for (i64 i in range(0, x)) { x = 0; }
  print(x);
}
// expect: 10070401
// expect: 3
// expect: 25
// expect: 9223372036854775806 2
// expect: só um 9223372036854775806
// expect: arg 1
// expect: arg 3
// expect: volta 1
// expect: volta 2
// expect: 0
