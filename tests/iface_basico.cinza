// interface: uma função e uma lista que aceitam qualquer classe que cumpra a interface.
interface Forma {
  fn area() -> decimal;
  fn nome() -> string;
}
class Circulo : Forma {
  decimal r = 1.0;
  pub {
    Circulo(decimal raio) { r = raio; }
    fn area() -> decimal { return 3.0 * r * r; }
    fn nome() -> string { return "círculo"; }
    fn raio() -> decimal { return r; }
  }
}
class Retangulo : Forma {
  decimal a = 1.0;
  decimal b = 1.0;
  pub {
    Retangulo(decimal x, decimal y) { a = x; b = y; }
    fn area() -> decimal { return a * b; }
    fn nome() -> string { return "retângulo"; }
  }
}
fn total(list<Forma> formas) -> decimal {
  decimal soma = 0.0;
  for (Forma f in formas) { soma += f.area(); }
  return soma;
}
fn descreve(Forma f) -> string { return f.nome() + " de área " + f.area(); }
fn main() {
  list<Forma> formas = [new Circulo(1.0), new Retangulo(2.0, 3.0)];
  print(total(formas));
  print(descreve(new Circulo(2.0)));
  Forma f = new Retangulo(1.5, 2.0);
  print(descreve(f), type(f), type(f) == Retangulo);
  formas.add(f);
  print(formas.size(), total(formas));
}
// expect: 9
// expect: círculo de área 12
// expect: retângulo de área 3 Retangulo true
// expect: 3 12
