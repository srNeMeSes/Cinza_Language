// interface: uma função e uma lista que aceitam qualquer classe que cumpra a interface.
interface Forma {
  fn area() -> f64;
  fn nome() -> string;
}
class Circulo : Forma {
  f64 r = 1.0ff;
  pub {
    Circulo(f64 raio) { r = raio; }
    fn area() -> f64 { return 3.0ff * r * r; }
    fn nome() -> string { return "círculo"; }
    fn raio() -> f64 { return r; }
  }
}
class Retangulo : Forma {
  f64 a = 1.0ff;
  f64 b = 1.0ff;
  pub {
    Retangulo(f64 x, f64 y) { a = x; b = y; }
    fn area() -> f64 { return a * b; }
    fn nome() -> string { return "retângulo"; }
  }
}
fn total(list<Forma> formas) -> f64 {
  f64 soma = 0.0ff;
  for (Forma f in formas) { soma += f.area(); }
  return soma;
}
fn descreve(Forma f) -> string { return f.nome() + " de área " + f.area(); }

fn main() {
  list<Forma> formas = [new Circulo(1.0ff), new Retangulo(2.0ff, 3.0ff)];
  print(total(formas));
  print(descreve(new Circulo(2.0ff)));
  Forma f = new Retangulo(1.5ff, 2.0ff);
  print(descreve(f), type(f), type(f) == Retangulo);
  formas.add(f);
  print(formas.size(), total(formas));
}
// expect: 9
// expect: círculo de área 12
// expect: retângulo de área 3 Retangulo true
// expect: 3 12
