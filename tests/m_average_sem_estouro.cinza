// Seção M: average soma em precisão estendida, então só a média precisa caber
// em f64 (antes a soma intermediária estourava e lançava OverflowError).
import Lists;
fn main() {
  f64 g = .0ff;
  print(Lists.average([g, g]), Lists.average([g, -g]), Lists.average([1, 2]), Lists.average([0.5f, 1.f]));
}
// expect: 1e+308 0 1.5 0.75
