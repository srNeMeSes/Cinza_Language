// Seção K: cast<T> com valor que não cabe (OverflowError) ou sem valor inteiro / texto
// inválido (ValueError).
fn tenta_i32(f64 x) {
  try { print(cast<i32>(x)); } except (OverflowError e) { print(e.message); }
  except (ValueError e) { print(e.message); }
}
fn tenta_texto(string s) {
  try { print(cast<i64>(s)); } except (OverflowError e) { print(e.message); }
  except (ValueError e) { print(e.message); }
}
fn main() {
  tenta_i32(2147483647.9ff);
  tenta_i32(2147483648.ff);
  tenta_i32(-2147483649.ff);
  i64 grande = 3000000000;
  try { print(cast<i32>(grande)); } except (OverflowError e) { print(e.message); }
  try { print(cast<i64>(10000000000000000000.ff)); } except (OverflowError e) { print(e.message); }
  tenta_texto("12a");
  tenta_texto(" 1");
  tenta_texto("1.5");
  tenta_texto("");
  tenta_texto("99999999999999999999");
  try { print(cast<f64>("abc")); } except (ValueError e) { print(e.message); }
  try { print(cast<f32>("1e39")); } except (OverflowError e) { print(e.message); }
  print(cast<f32>("1e-50"), cast<f64>("1e-400"));
}
// expect: 2147483647
// expect: cast<i32>(2147483648): o valor não cabe em i32
// expect: cast<i32>(-2147483649): o valor não cabe em i32
// expect: cast<i32>(3000000000): o valor não cabe em i32
// expect: cast<i64>(1e+19): o valor não cabe em i64
// expect: cast<i64>("12a"): não é um número inteiro (só sinal e dígitos)
// expect: cast<i64>(" 1"): não é um número inteiro (só sinal e dígitos)
// expect: cast<i64>("1.5"): não é um número inteiro (só sinal e dígitos)
// expect: cast<i64>(""): não é um número inteiro (só sinal e dígitos)
// expect: cast<i64>("99999999999999999999"): o valor não cabe em i64
// expect: cast<f64>("abc"): não é um número (ex.: 2.5, -3, 1e10)
// expect: cast<f32>("1e39"): o valor não cabe em f32
// expect: 0 0
