// Varredura L: range como lista tem o limite de Lists.repeat (100 milhões de
// elementos); antes esgotava a memória com erro interno. No for, que não cria a
// lista, não há limite.
fn main() {
  try { print(range(0, 1000000000).size()); } except (ValueError e) { print(e.message); }
  try { print(range(100000001, 0, -1).size()); } except (ValueError e) { print(e.message); }
  try { print(range(cast<i64>(0), 9223372036854775807, 2).size()); } except (ValueError e) { print(e.message); }
  i64 n = 0;
  for (i64 i in range(0, 200000000, 1000)) { n += 1; }
  print(n, range(0, 3).size(), range(1000, 0, -1).size());
}
// expect: 'range' de mais de 100 milhões de elementos (use-o direto no for, que não cria a lista)
// expect: 'range' de mais de 100 milhões de elementos (use-o direto no for, que não cria a lista)
// expect: 'range' de mais de 100 milhões de elementos (use-o direto no for, que não cria a lista)
// expect: 200000 3 1000
