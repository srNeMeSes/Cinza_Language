// 8.4: mais de 64 cópias encadeadas; o rastro abrevia como o stack trace
fn cresce[T](T x, i32 n) -> i32 {
  if (n == 0) { return 0; }
  list<T> l = [x];
  return cresce(l, n - 1);
}
fn main() { print(cresce(1, 3)); }
