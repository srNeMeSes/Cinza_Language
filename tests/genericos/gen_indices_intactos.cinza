// N1: índices, fatias e chaves continuam iguais ao lado da leitura f[tipo](...)
fn dobro(i32 x) -> i32 { return x * 2; }
fn main() {
  list<i32> l = [1, 2, 3];
  dict<string, i32> d = {{"a", 10}};
  string s = "cinza";
  print(l[l[0]], d["a"], s[1:3], dobro(l[2]), l[dobro(1) - 1]);
  list<list<i32>> m = [[4, 5], [6]];
  print(m[0][1], m[1][0], (l[0]));
  l[0] = 9;
  m[1][0] = 7;
  print(l, m);
  printf("{l[1]} {s[0:2]} {dobro(l[0])}");
}
// expect: 2 10 in 6 2
// expect: 5 6 1
// expect: [9, 2, 3] [[4, 5], [7]]
// expect: 2 ci 18
