// genérica usada em inicializador de campo (class e struct) e em enum
fn maior[T](T a, T b) -> T {
  if (a > b) { return a; }
  return b;
}
enum Cor { Vermelho, Verde }
fn id[T](T x) -> T { return x; }
class C { i32 v = maior(3, 8); pub { fn valor() -> i32 { return v; } } }
struct S { i32 v = maior(1, 2); }
fn main() { print(new C().valor(), new S().v, id(Cor.Verde), id[Cor](Cor.Vermelho) == Cor.Vermelho); }
// expect: 8 2 Cor.Verde true
