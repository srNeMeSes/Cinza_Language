// 8.3: i32 e i64 no mesmo T combinam no mais largo; o i32 é promovido
fn maior[T](T a, T b) -> T {
  if (a > b) { return a; }
  return b;
}
fn main() {
  i32 a = 7;
  i64 b = 3;
  var m = maior(a, b);
  f32 x = 1.5f;
  f64 y = 0.5ff;
  var n = maior(x, y);
  print(m, type(m), n, type(n));
}
// expect: 7 i64 1.5 f64
