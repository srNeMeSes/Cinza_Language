// dict<T, i32> com T = list<i32>: a chave inválida aparece na cópia
fn conta[T](list<T> l) -> dict<T, i32> {
  dict<T, i32> d;
  for (T x in l) { d.add({x, 1}); }
  return d;
}
fn main() {
  print(conta(["a", "b"]));
  print(conta([[1]]));
}
// expect-error: Chave de dict deve ser
// expect-error:     em conta[list<i32>], usada em tests/genericos/gen_chave_invalida.cinza:9
