// var no corpo vale com primitivos; com list é o erro de sempre, com rastro
fn copia[T](T x) -> T {
  var y = x;
  return y;
}
fn main() {
  print(copia(3), copia("a"));
  print(copia([1]));
}
// expect-error: Inferência 'var' só é permitida para tipos primitivos
// expect-error:     em copia[list<i32>], usada em tests/genericos/gen_var_no_corpo.cinza:8
