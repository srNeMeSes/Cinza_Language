// Q2 (programas grandes): um main com 400 linhas (mais de 3000 instruções da CIR) com
// objetos, strings, listas e erros pegos. No cinzac -O2 uma função assim vai sem
// otimização (optnone), num segundo objeto gerado em -O0: o LLVM crescia mais que linear
// com milhares de blocos (o main de 1000 linhas com objetos levava 11 s). O resultado é o
// mesmo nos dois backends, sem vazamento, e o erro não pego no fim ainda sai com o trace certo.
class Conta {
  i32 v = 0;
  pub {
    Conta(i32 x) { v = x * 2; }
    fn valor() -> i32 { return v; }
  }
}

fn soma(list<i32> l) -> i32 {
  i32 s = 0;
  for (i32 x in l) { s += x; }
  return s;
}

fn main() {
  i64 t = 0;
  i32 erros = 0;
  list<i32> l = [10, 20, 30];
  list<string> nomes;
  t += new Conta(0).valor() % 10;
  nomes.add("n1" + cast<string>(1));
  t += soma([2, 3, 4]);
  try { t += l[3]; } except (IndexError e) { erros += 1; }
  t += new Conta(4).valor() % 10;
  nomes.add("n5" + cast<string>(5));
  t += soma([6, 7, 8]);
