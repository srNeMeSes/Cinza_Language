// Q11: structs numa lista sem clones a mais no cinzac — lista[i].campo lê o campo direto do
// elemento, e o for toma cada struct da cópia que ele percorre. O resultado é o mesmo da CVM:
// a variável do for é uma cópia (mudá-la não muda a lista), guardá-la guarda uma cópia, e mudar
// a lista dentro do laço não muda o laço.
struct Dentro { f64 y = 0.0ff; }
struct Q { list<Q> f; i32 v = 0; }
struct P { i32 x = 0; string nome = ""; list<i32> xs; Dentro d = new Dentro(); }
fn le(list<P> ps, i32 i) {
  try { print(ps[i].x); } except (Error e) { print(e.kind, e.message); }
}
fn main() {
  list<P> ps;
  for (i32 i in range(0, 4)) {
    P p = new P(x: i, nome: "p" + cast<string>(i));
    p.xs.add(i * 10);
    p.d.y = cast<f64>(i) / 2.0ff;
    ps.add(p);
  }
  i32 j = 2;
  print(ps[0].x, ps[j].nome, ps[3].xs, ps[1].d.y, ps[j].d);
  le(ps, 4);
  le(ps, -1);
  // a variável do for é uma cópia
  list<P> guardados;
  i32 soma = 0;
  for (P p in ps) {
    soma += p.x;
    p.x = 100;
    p.nome = "mudou";
    guardados.add(p);
    ps.add(new P(x: 7));   // a lista muda; o laço não
  }
  print(soma, ps.size(), ps[0].x, ps[0].nome, guardados[1].x, guardados[1].nome);
  // a lista dentro do struct é compartilhada pela cópia (cópia rasa): o for a vê
  for (P p in ps) { if (p.x == 0) { p.xs.add(1); } }
  print(ps[0].xs);
  // ps[i].campo numa expressão maior e numa atribuição
  ps[1] = new P(x: ps[1].x + ps[2].x, nome: ps[1].nome + ps[2].nome);
  print(ps[1].x, ps[1].nome);
  // o destino é a própria lista (a CVM usa o caminho de sempre: o índice não pode ir nela)
  list<Q> qs = [new Q(v: 1)];
  qs[0].f.add(new Q(v: 2));
  qs = qs[0].f;
  print(qs.size(), qs[0].v);
}
// expect: 0 p2 [30] 0.5 Dentro{y: 1}
// expect: IndexError índice 4 fora dos limites (tamanho: 4)
// expect: IndexError índice -1 fora dos limites (tamanho: 4)
// expect: 6 8 0 p0 100 mudou
// expect: [0, 1]
// expect: 3 p1p2
// expect: 1 2
