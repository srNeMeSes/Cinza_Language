// P5: strings no código nativo (cinzac) — concatenação com outros tipos, comparações,
// índice, fatia, size, for em string, cast nos dois sentidos, printf/format, nativas de
// texto e const. Os mesmos resultados da CVM. Roda nos dois backends.
import Strings;

const string NOME = "Cinza";
const string SAUDACAO = "olá, " + NOME + "!";

fn inicial(string s) -> string {
  return s[0];
}

fn main() {
  print(SAUDACAO, SAUDACAO.size(), inicial(NOME));
  string s = "ação" + 1 + true + 2.5ff + "x";
  print(s, s.size(), s[1], s[-2], s[0:4], s[::3], s[4:]);
  // comparações: a ordem do std::string (bytes)
  print("abc" < "abd", "b" > "abc", "a" <= "a", "Z" < "a", "x" == "x", "x" != "y");
  // cast<string> e de volta
  string n = cast<string>(255) + cast<string>(-1.5f) + cast<string>(9000000000);
  print(n, cast<i32>("-42") * 2, cast<i64>("9000000000"), cast<f32>("0.1"), cast<f64>("1e3"));
  // printf e format, com largura e casas
  i32 x = 7;
  f64 pi = 3.14159ff;
  printf("[{x}] [{x:4}] [{pi:.2f}] [{pi:8.3f}] [{NOME}] [{NOME:7}] [{x * 2}]");
  string f = format("{x}/{pi:.1f}");
  print(f, f.size());
  printf("sem campos");
  // for em string: um caractere UTF-8 por vez
  string invertida = "";
  for (string c in "pão!") {
    invertida = c + invertida;
  }
  print(invertida);
  // nativas que recebem e devolvem string
  print(Strings.upper("çã"), Strings.lower("ABC"), Strings.trim("  meio  "), Strings.replace("a-b-c", "-", "+"));
  print(Strings.starts_with(NOME, "Ci"), Strings.find("banana", "na"), Strings.count("banana", "a"));
}
// expect: olá, Cinza! 11 C
// expect: ação1true2.5x 13 ç 5 ação aor2x 1true2.5x
// expect: true true true true true true
// expect: 255-1.59000000000 -84 9000000000 0.1 1000
// expect: [7] [   7] [3.14] [   3.142] [Cinza] [Cinza  ] [14]
// expect: 7/3.1 5
// expect: sem campos
// expect: !oãp
// expect: ÇÃ abc meio a+b+c
// expect: true 2 3
