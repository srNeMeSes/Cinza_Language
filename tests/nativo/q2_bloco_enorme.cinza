  pub {
    fn soma() -> i64 {
      i64 s = 0;
      s += cast<i64>(c0) + cast<i64>(c400) + cast<i64>(c799);
      return s;
    }
    fn muda() { c799 = 1000; c0 += 1; }
  }
}
fn main() {
  Larga a = new Larga();
  print(a.soma());
  a.muda();
  print(a.soma());
}
// expect: 35
// expect: 1013
