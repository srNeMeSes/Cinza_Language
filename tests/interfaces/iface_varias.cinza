// interface: uma classe pode cumprir várias interfaces.
interface Nomeado { fn nome() -> string; }
interface Contavel { fn conta(i64 vezes) -> i64; }

class Moeda : Nomeado, Contavel {
  i64 valor = 5;
  pub {
    fn nome() -> string { return "moeda"; }
    fn conta(i64 vezes) -> i64 { return valor * vezes; }
  }
}

fn mostra(Nomeado n) { print(n.nome()); }
fn soma(Contavel c) -> i64 { return c.conta(3); }

fn main() {
  Moeda m = new Moeda();
  mostra(m);
  print(soma(m));
}
// expect: moeda
// expect: 15
