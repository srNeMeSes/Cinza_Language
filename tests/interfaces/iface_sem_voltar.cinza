// interface: um valor do tipo interface nunca volta a ser tratado como a classe.
interface Forma {
  fn area() -> f64;
  fn nome() -> string;
}
class Circulo : Forma {
  f64 r = 1.0ff;
  pub {
    Circulo(f64 raio) { r = raio; }
    fn area() -> f64 { return 3.0ff * r * r; }
    fn nome() -> string { return "círculo"; }
    fn raio() -> f64 { return r; }
  }
}
class Retangulo : Forma {
  f64 a = 1.0ff;
  f64 b = 1.0ff;
  pub {
    Retangulo(f64 x, f64 y) { a = x; b = y; }
    fn area() -> f64 { return a * b; }
    fn nome() -> string { return "retângulo"; }
  }
}
fn main() {
  Forma f = new Circulo(1.0ff);
  Circulo c = f;
}
// expect-error: Tipo incompatível na declaração de 'c': declarado 'Circulo', mas atribuído 'Forma'
